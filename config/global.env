# Global shared configuration for all benchmarks
# These are not secrets and should be committed to the repository

DYNACONF_ADVANCED_FEATURES__LANGFUSE_TRACING=true
DYNACONF_ADVANCED_FEATURES__TRACKER_ENABLED=true

# Registry is required for tool discovery/binding in every benchmark (m3, appworld,
# bpo, oak_health_insurance all set DYNACONF_ADVANCED_FEATURES__REGISTRY=true in
# their own config). No default here — load_env.sh loads this file before the
# per-benchmark one in no-override mode, so a false/true default set here would
# silently win over every benchmark's own setting instead of leaving it alone.
