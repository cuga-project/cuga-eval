# Variant "stage1": the caps 2-3 presets as the first campaign-runtime A/B shipped them
# (2026-10-13: FC preamble knobs, no harness riders, no find_tools wall, 70 steps, 150 s LLM /
# 220 s item timeouts, campaign CUGA settings) — without the second round of parity fields:
# registry <domain>_<tool> names, the SDK shortlister, no tool cap, no temperature pin, policy DB
# loaded. Arm syntax: cuga_eval_<preset>[_fc]@stage1. In kit runs the temperature (1.0 via
# AGENT_SETTING_CONFIG) and policies (--no-policies) match either way.
M3_ADAPTER_TOOL_CAP=none
M3_ADAPTER_BARE_TOOL_NAMES=false
M3_ADAPTER_SHORTLIST_STRATEGY=sdk
M3_ADAPTER_MODEL_TEMPERATURE=none
M3_ADAPTER_USE_POLICY_SYSTEM=true
