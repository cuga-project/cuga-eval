# cap4 A/B arm P (2026-10-31): the cap4 preset + refusal persistence outside a retriever-only scope, with every
# answer stage logged (stage_trace) and the composer's rewrite of the final answer logged, not applied.
# One run scores each step offline: the answer before persistence is the plain cap4 preset's.
M3_ADAPTER_REFUSAL_PERSIST=true
M3_ADAPTER_STAGE_TRACE=true
M3_ADAPTER_TRACE_COMPOSER=true
