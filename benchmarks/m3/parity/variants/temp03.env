# Agent (and adapter LLM steps) at temperature 0.3 instead of the campaign's 1.0: tests whether sampling at 1.0
# corrupts long copied values (Cyrillic letters, '???', truncated names seen in cap1 list answers).
# The settings file is generated by: source benchmarks/m3/parity/env.sh 0.3
AGENT_SETTING_CONFIG="$PARITY_DIR/.local/settings.openai.temp0.3.toml"
PARITY_TEMPERATURE=0.3
# The presets pin model_temperature (campaign: 1.0) on every model block; override it too.
M3_ADAPTER_MODEL_TEMPERATURE=0.3
