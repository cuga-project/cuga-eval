# cap2 safeguard B: bind 3 (pool 32, cosine fill, no hint) as before; after a failure in the task (no rows, an
# error, or a re-ask) later model calls bind 10 tools, so a wrong pick costs a round instead of the task.
M3_ADAPTER_TOOL_PICK_POOL=32
M3_ADAPTER_TOOL_PICK_BIND=3
M3_ADAPTER_TOOL_PICK_FILL=cosine
M3_ADAPTER_TOOL_PICK_HINT=false
M3_ADAPTER_TOOL_PICK_WIDEN=10
