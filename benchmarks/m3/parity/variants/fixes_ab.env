# The two adapter fixes from the 2026-10-19 failure review: (A) a call that returns no rows or only zeros is
# retried once with lowercased text arguments; (B) the fact-check only applies corrections found in a tool result,
# and a re-ask cut by agent_timeout answers with the earlier draft instead of nothing.
M3_ADAPTER_LOWERCASE_RETRY=true
M3_ADAPTER_FACT_CHECK_STRICT=true
M3_ADAPTER_KEEP_DRAFT_ON_TIMEOUT=true
