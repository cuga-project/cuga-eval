# Variant "pre_parity": the adapter as it ran before the campaign-runtime fields existed
# (the 2026-10-12 cap3 FC gate run). Arm syntax: cuga_eval_<preset>[_fc]@pre_parity.
# Every line is an M3_ADAPTER_<FIELD> override of the preset (see adapter/config.py).
M3_ADAPTER_FC_STEP_DISCIPLINE=off
M3_ADAPTER_FC_PROMPT_FRAGMENTS=
M3_ADAPTER_FC_ANSWER_FORMAT=false
M3_ADAPTER_HARNESS_INSTRUCTIONS=true
M3_ADAPTER_EXPOSE_ALL_TOOLS=false
M3_ADAPTER_MAX_STEPS=none
M3_ADAPTER_LLM_HTTP_TIMEOUT=none
M3_ADAPTER_AGENT_TIMEOUT=none
M3_ADAPTER_DEMO_BOUND_NAMES=false
M3_ADAPTER_CUGA_SETTINGS=
M3_ADAPTER_CAP2_VERBATIM=true
M3_ADAPTER_TOOL_CAP=none
M3_ADAPTER_BARE_TOOL_NAMES=false
M3_ADAPTER_SHORTLIST_STRATEGY=sdk
M3_ADAPTER_MODEL_TEMPERATURE=none
M3_ADAPTER_USE_POLICY_SYSTEM=true
