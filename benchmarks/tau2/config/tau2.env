# tau2-bench (τ²) benchmark-specific configuration.
# These are not secrets and should be committed to the repository.
#
# Loaded by config_loader.load_eval_config("tau2") AFTER config/global.env,
# so anything left unset here inherits global.env's value.

# config_loader defaults LOGURU_LEVEL to WARNING otherwise — hides logger.info in eval loops.
LOGURU_LEVEL=DEBUG

# ── CUGA mode / features (ported from exgentic agents/cuga_sdk/configs/tau2.py) ──
DYNACONF_FEATURES__CUGA_MODE=accurate
DYNACONF_FEATURES__CHAT=false
DYNACONF_ADVANCED_FEATURES__FORCE_AUTONOMOUS_MODE=true
DYNACONF_ADVANCED_FEATURES__CUGA_LITE_NL_AUTO_CONTINUE=true
DYNACONF_ADVANCED_FEATURES__REFLECTION_ENABLED=true
DYNACONF_ADVANCED_FEATURES__LITE_MODE=true
DYNACONF_ADVANCED_FEATURES__ENABLE_TODOS=false
DYNACONF_POLICY__ENABLED=false
DYNACONF_ADVANCED_FEATURES__BENCHMARK=tau2

# ── SAFETY PIN 1 — keep tool execution IN-PROCESS so the queue/Future bridge works ──
# With e2b on, CUGA runs generated code in a separate process and the in-process
# bridge becomes unreachable -> deadlock. Verified key spelling against cuga
# settings.toml (advanced_features.e2b_sandbox; default false).
DYNACONF_ADVANCED_FEATURES__E2B_SANDBOX=false

# ── Code-block execution timeout (cuga #365: configurable; default 30s) ──
# A tool round-trip that exceeds this is cancelled -> CUGA retries -> τ² could run
# the tool twice (§11.1b). Raised here as a backstop so a slow orchestrator-run tool
# can't trip it. Validated on cuga 0.2.28: a 35s wait completes (no timeout/retry).
# Tunable. (Requires cuga >= #365; on older cuga this key is ignored — timeout was 30s hardcoded.)
DYNACONF_ADVANCED_FEATURES__SANDBOX_EXECUTION_TIMEOUT=120

# ── SAFETY PIN 2 — do NOT override REGISTRY here ──
# It inherits `false` from config/global.env. tau2 tools come from tau2's own
# environment via decoy tools, NOT from cuga-eval's MCP registry.
# (Intentionally omitted: DYNACONF_ADVANCED_FEATURES__REGISTRY)

# ── Paths ──
# tau2's data dir. tau2 defaults to its in-repo data/ when TAU2_DATA_DIR is unset
# (src/tau2/utils/utils.py), so this is optional; set it only to override.
# TAU2_DATA_DIR="benchmarks/tau2/tau2-bench/data"
CUGA_LOGGING_DIR="benchmarks/tau2/logging"
