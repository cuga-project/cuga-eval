"app": "google_sheets", "record": {"id": "ss_customers/ws_queue_config", "spreadsheet": "Customer Tiers", "worksheet": "Queue Routing Config", "headers": ["Rule", "Condition", "Queue_Group_ID", "Notes"], "rows": [{"id": "a2de07a9f2324c5f83c0921fb7ef21af", "spreadsheet_id": "ss_customers", "worksheet_id": "ws_queue_config", "row_id": 2, "cells": {"Rule": "Enterprise + api", "Condition": "Tier=Enterprise AND tags contain api", "Queue_Group_ID": "grp_senior_api", "Notes": "Enterprise always senior"}, "text_format_bold": false, "text_format_italic": false, "text_format_strikethrough": false, "timezone": false}, {"id": "be176da4484d4ba59e6a84e8648647af", "spreadsheet_id": "ss_customers", "worksheet_id": "ws_queue_config", "row_id": 3, "cells": {"Rule": "Enterprise + billing", "Condition": "Tier=Enterprise AND tags contain billing", "Queue_Group_ID": "grp_senior_billing", "Notes": "Enterprise always senior"}, "text_format_bold": false, "text_format_italic": false, "text_format_strikethrough": false, "timezone": false}, {"id": "62bc112de6834a67ae704bc47fa4524e", "spreadsheet_id": "ss_customers", "worksheet_id": "ws_queue_config", "row_id": 4, "cells": {"Rule": "Enterprise + integration", "Condition": "Tier=Enterprise AND tags contain integration", "Queue_Group_ID": "grp_senior_integrations", "Notes": "Enterprise always senior"}, "text_format_bold": false, "text_format_italic": false, "text_format_strikethrough": false, "timezone": false}, {"id": "7e88f0e5327e400b843be44cea9dece3", "spreadsheet_id": "ss_customers", "worksheet_id": "ws_queue_config", "row_id": 5, "cells": {"Rule": "Enterprise + other", "Condition": "Tier=Enterprise AND no specific area", "Queue_Group_ID": "grp_senior_general", "Notes": "Enterprise always senior"}, "text_format_bold": false, "text_format_italic": false, "text_format_strikethrough": false, "timezone": false}, {"id": "dca47c5890674d0c868b0c0f903c57dc", "spreadsheet_id": "ss_customers", "worksheet_id": "ws_queue_config", "row_id": 6, "cells": {"