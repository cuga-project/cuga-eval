[
 {
  "name": "salesforce_find_records",
  "description": "Find record(s) in Salesforce by field value. Supports partial/substring matching.",
  "inputSchema": {
   "description": "Find record(s) in Salesforce by field value. Supports partial/substring matching.",
   "properties": {
    "object": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Salesforce object type. Valid types: Contact, Account, Lead, Opportunity, Campaign, Case, Event, Task, Note, CampaignMember, User",
     "title": "Object"
    },
    "searchField": {
     "default": "",
     "description": "Field name to search by. Common fields per object: - Contact: Email, Name, FirstName, LastName, AccountId, Title, Phone, OwnerId - Account: Name, Industry, OwnerId - Lead: Email, Name, FirstName, LastName, Company, Status, OwnerId - Opportunity: Name, StageName, AccountId, OwnerId, Amount, CloseDate - Campaign: Name, Status, Type - CampaignMember: CampaignId, ContactId, LeadId - Case: Subject, Status, AccountId, ContactId, Priority - User: Name, Email, IsActive - Task/Event: Subject, WhatId, WhoId, OwnerId, Status",
     "title": "Searchfield",
     "type": "string"
    },
    "searchValue": {
     "default": "",
     "description": "Value to search for (case-insensitive, supports partial match)",
     "title": "Searchvalue",
     "type": "string"
    },
    "searchResults": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": "first",
     "description": "\"first\" for first match, \"all\" for all matches (default: \"first\")",
     "title": "Searchresults"
    },
    "object_type": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Object Type"
    }
   },
   "title": "salesforce_find_records",
   "type": "object"
  }
 },
