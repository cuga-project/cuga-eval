  {
   "id": "ws_flagging_rules",
   "kind": "md",
   "title": "Contact Management Policy: Flagging Rules",
   "trust": "trusted",
   "effective_date": null,
   "authority_rank": 0,
   "sections": [
    {
     "id": "preamble",
     "title": "Preamble",
     "page": null,
     "parent": null,
     "statements": [
      {
       "id": "ws_flagging_rules:preamble:1",
       "text": "Secondment Exclusion | Contacts whose Salesforce Notes indicate a 'temporary secondment' or 'secondment' are not job changers. Their LinkedIn may show a different company but they have not permanently moved. Do NOT flag these contacts as job changes.",
       "types": [],
       "modality": null,
       "source": {
        "document": "ws_flagging_rules",
        "section": "preamble",
        "page": null,
        "line": 5,
        "table_header": [
         "Rule",
         "Description"
        ]
       },
       "quote": "Secondment Exclusion | Contacts whose Salesforce Notes indicate a 'temporary secondment' or 'secondment' are not job changers. Their LinkedIn may show a different company but they have not permanently moved. Do NOT flag these contacts as job changes."
      },
      {
       "id": "ws_flagging_rules:preamble:2",
       "text": "Email Override | Internal emails from staff providing context about a contact always take precedence over LinkedIn data. If an email says a contact has NOT moved, that overrides the LinkedIn headline.",
       "types": [],
       "modality": null,
       "source": {
        "document": "ws_flagging_rules",
        "section": "preamble",
        "page": null,
        "line": 6,
        "table_header": [
         "Rule",
         "Description"
        ]
       },
       "quote": "Email Override | Internal emails from staff providing context about a contact always take precedence over LinkedIn data. If an email says a contact has NOT moved, that overrides the LinkedIn headline."
      },
      {
       "id": "ws_flagging_rules:preamble:3",
       "text": "Company Rebrand Exclusion | If internal emails indicate a company has rebranded or renamed (same legal entity, new trading name), the contact has NOT changed jobs. Cross-reference emails before flagging anyone whose LinkedIn company name differs only due to a rebrand.",
       "types": [],
       "modality": null,
       "source": {
        "document": "ws_flagging_rules",
        "section": "preamble",
        "page": null,
        "line": 7,
        "table_header": [
         "Rule",
         "Description"
        ]
       },
       "quote": "Company Rebrand Exclusion | If internal emails indicate a company has rebranded or renamed (same legal entity, new trading name), the contact has NOT changed jobs. Cross-reference emails before flagging anyone whose LinkedIn company name differs only due to a rebrand."
      },
      {
       "id": "ws_flagging_rules:preamble:4",
       "text": "Title Change Exclusion | A change in job title at the SAME company is NOT a job change — only a company change qualifies. If the LinkedIn headline shows a different title but the same company name as in Salesforce, do NOT flag as a job change. Promotions and internal role changes must be ignored.",
       "types": [],
       "modality": null,
       "source": {
        "document": "ws_flagging_rules",
        "section": "preamble",
        "page": null,
        "line": 8,
        "table_header": [
         "Rule",
         "Description"
        ]
       },
       "quote": "Title Change Exclusion | A change in job title at the SAME company is NOT a job change — only a company change qualifies. If the LinkedIn headline shows a different title but the same company name as in Salesforce, do NOT flag as a job change. Promotions and internal role changes must be ignored."
      }
     ],
     "source": {},
     "quote": ""
    }
   ],
