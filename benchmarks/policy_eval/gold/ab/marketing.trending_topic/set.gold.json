  {
   "id": "slack_msg_vp_trend",
   "kind": "md",
   "title": "Slack message in #leadership from rachel.kim",
   "trust": "trusted",
   "effective_date": "2026-01-28",
   "authority_rank": 1,
   "sections": [
    {
     "id": "preamble",
     "title": "Preamble",
     "page": null,
     "parent": null,
     "statements": [
      {
       "id": "slack_msg_vp_trend:preamble:1",
       "text": "Heads up everyone -- effective immediately, new trending topic criteria (supersedes the Content Ops batch email for this cycle):",
       "types": [
        "exception_override"
       ],
       "modality": "must",
       "source": {
        "document": "slack_msg_vp_trend",
        "section": "preamble",
        "page": null,
        "line": 3
       },
       "quote": "Heads up everyone -- effective immediately, new trending topic criteria (supersedes the Content Ops batch email for this cycle):"
      },
      {
       "id": "slack_msg_vp_trend:preamble:2",
       "text": "Topics must have at least 5,000 mentions THIS week to qualify for backlog (not just growth % -- raw volume matters now).",
       "types": [
        "threshold",
        "eligibility_filter"
       ],
       "modality": "must",
       "source": {
        "document": "slack_msg_vp_trend",
        "section": "preamble",
        "page": null,
        "line": 5,
        "step": 1
       },
       "quote": "Topics must have at least 5,000 mentions THIS week to qualify for backlog (not just growth % -- raw volume matters now)."
      },
      {
       "id": "slack_msg_vp_trend:preamble:3",
       "text": "Topics must be in our core industry verticals: B2B SaaS, CRM, Sales Enablement, Marketing Automation, or Workflow Productivity. No consumer topics.",
       "types": [
        "eligibility_filter",
        "prohibition"
       ],
       "modality": "must",
       "source": {
        "document": "slack_msg_vp_trend",
        "section": "preamble",
        "page": null,
        "line": 6,
        "step": 2
       },
       "quote": "Topics must be in our core industry verticals: B2B SaaS, CRM, Sales Enablement, Marketing Automation, or Workflow Productivity. No consumer topics."
      },
      {
       "id": "slack_msg_vp_trend:preamble:4",
       "text": "OFF-LIMITS topics -- do NOT add these regardless of volume:",
       "types": [
        "prohibition"
       ],
       "modality": "must_not",
       "source": {
        "document": "slack_msg_vp_trend",
        "section": "preamble",
        "page": null,
        "line": 7,
        "step": 3
       },
       "quote": "OFF-LIMITS topics -- do NOT add these regardless of volume:"
      },
      {
       "id": "slack_msg_vp_trend:preamble:5",
       "text": "Anything mentioning competitor brand names (RivalCo, Zerion, etc.)",
       "types": [
        "prohibition",
        "eligibility_filter"
       ],
       "modality": "must_not",
       "source": {
        "document": "slack_msg_vp_trend",
        "section": "preamble",
        "page": null,
        "line": 8
       },
       "quote": "Anything mentioning competitor brand names (RivalCo, Zerion, etc.)"
      },
      {
       "id": "slack_msg_vp_trend:preamble:6",
       "text": "'Blockchain' anything -- we are not a blockchain company",
       "types": [
        "prohibition",
        "eligibility_filter"
       ],
       "modality": "must_not",
       "source": {
        "document": "slack_msg_vp_trend",
        "section": "preamble",
        "page": null,
        "line": 9
       },
       "quote": "'Blockchain' anything -- we are not a blockchain company"
      },
      {
       "id": "slack_msg_vp_trend:preamble:7",
       "text": "'Remote Work' variants -- our research shows poor conversion for us",
       "types": [
        "prohibition",
        "eligibility_filter"
       ],
       "modality": "must_not",
       "source": {
        "document": "slack_msg_vp_trend",
        "section": "preamble",
        "page": null,
        "line": 10
       },
       "quote": "'Remote Work' variants -- our research shows poor conversion for us"
      },
      {
       "id": "slack_msg_vp_trend:preamble:8",
       "text": "The batch code for Slack posts must be TREND-20260127-Q1 (use this exact code, not any older batch codes from the Content Ops email).",
       "types": [
        "format",
        "exception_override"
       ],
       "modality": "must",
       "source": {
        "document": "slack_msg_vp_trend",
        "section": "preamble",
        "page": null,
        "line": 11,
        "step": 4
       },
