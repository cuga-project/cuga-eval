   "id": "msg_trending_batch",
   "kind": "md",
   "title": "Trending Topic Batch Tracking - W04",
   "trust": "trusted",
   "effective_date": "2026-01-27",
   "authority_rank": 0,
   "sections": [
    {
     "id": "preamble",
     "title": "Preamble",
     "page": null,
     "parent": null,
     "statements": [
      {
       "id": "msg_trending_batch:preamble:1",
       "text": "Hi,",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_trending_batch",
        "section": "preamble",
        "page": null,
        "line": 3
       },
       "quote": "Hi,"
      },
      {
       "id": "msg_trending_batch:preamble:2",
       "text": "For this week's trending topic batch:",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_trending_batch",
        "section": "preamble",
        "page": null,
        "line": 5
       },
       "quote": "For this week's trending topic batch:"
      },
      {
       "id": "msg_trending_batch:preamble:3",
       "text": "Include tracking code TREND-W04-2026 in every backlog row (add it to a batch_ref column or source column)",
       "types": [
        "required_field",
        "format"
       ],
       "modality": "must",
       "source": {
        "document": "msg_trending_batch",
        "section": "preamble",
        "page": null,
        "line": 7,
        "step": 1
       },
       "quote": "Include tracking code TREND-W04-2026 in every backlog row (add it to a batch_ref column or source column)"
      },
      {
       "id": "msg_trending_batch:preamble:4",
       "text": "Include the computed growth percentage in the source column for each topic",
       "types": [
        "required_field",
        "derived_value"
       ],
       "modality": "must",
       "source": {
        "document": "msg_trending_batch",
        "section": "preamble",
        "page": null,
        "line": 8,
        "step": 2
       },
       "quote": "Include the computed growth percentage in the source column for each topic"
      },
      {
       "id": "msg_trending_batch:preamble:5",
       "text": "Do not add topics with negative sentiment to the backlog -- creating content around negative framing would harm our brand",
       "types": [
        "prohibition",
        "eligibility_filter"
       ],
       "modality": "must_not",
       "source": {
        "document": "msg_trending_batch",
        "section": "preamble",
        "page": null,
        "line": 9,
        "step": 3
       },
       "quote": "Do not add topics with negative sentiment to the backlog -- creating content around negative framing would harm our brand"
      },
      {
       "id": "msg_trending_batch:preamble:6",
       "text": "Only add topics with meaningful growth (at least 50% increase)",
       "types": [
        "threshold",
        "eligibility_filter"
       ],
       "modality": "must",
       "source": {
        "document": "msg_trending_batch",
        "section": "preamble",
        "page": null,
        "line": 10,
        "step": 4
       },
       "quote": "Only add topics with meaningful growth (at least 50% increase)"
      },
      {
       "id": "msg_trending_batch:preamble:7",
       "text": "Thanks,",
