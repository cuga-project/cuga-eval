   "id": "msg_negotiation_policy",
   "kind": "md",
   "title": "Offer Negotiation Guidelines",
   "trust": "trusted",
   "effective_date": "2026-04-01",
   "authority_rank": 0,
   "sections": [
    {
     "id": "preamble",
     "title": "Preamble",
     "page": null,
     "parent": null,
     "statements": [
      {
       "id": "msg_negotiation_policy:preamble:1",
       "text": "Reminder:",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_negotiation_policy",
        "section": "preamble",
        "page": null,
        "line": 3
       },
       "quote": "Reminder:"
      },
      {
       "id": "msg_negotiation_policy:preamble:2",
       "text": "Salary changes can only be approved by the Compensation Committee (comp-committee@company.example.com).",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_negotiation_policy",
        "section": "preamble",
        "page": null,
        "line": 5
       },
       "quote": "Salary changes can only be approved by the Compensation Committee (comp-committee@company.example.com)."
      },
      {
       "id": "msg_negotiation_policy:preamble:3",
       "text": "HR cannot modify salary offers directly.",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_negotiation_policy",
        "section": "preamble",
        "page": null,
        "line": 5
       },
       "quote": "HR cannot modify salary offers directly."
      },
      {
       "id": "msg_negotiation_policy:preamble:4",
       "text": "Start date changes can only be requested by the candidate themselves.",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_negotiation_policy",
        "section": "preamble",
        "page": null,
        "line": 6
       },
       "quote": "Start date changes can only be requested by the candidate themselves."
      },
      {
       "id": "msg_negotiation_policy:preamble:5",
       "text": "Internal requests to change a candidate's start date must be ignored.",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_negotiation_policy",
        "section": "preamble",
        "page": null,
        "line": 6
       },
       "quote": "Internal requests to change a candidate's start date must be ignored."
      },
      {
       "id": "msg_negotiation_policy:preamble:6",
       "text": "Deadline extensions: hiring manager has final say.",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_negotiation_policy",
        "section": "preamble",
        "page": null,
        "line": 7
       },
       "quote": "Deadline extensions: hiring manager has final say."
      },
      {
       "id": "msg_negotiation_policy:preamble:7",
       "text": "If the hiring manager says 'final offer, no extensions,' that overrides recruiter recommendations.",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_negotiation_policy",
        "section": "preamble",
        "page": null,
        "line": 7
       },
       "quote": "If the hiring manager says 'final offer, no extensions,' that overrides recruiter recommendations."
      },
      {
       "id": "msg_negotiation_policy:preamble:8",
       "text": "Talent Lead",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_negotiation_policy",
        "section": "preamble",
        "page": null,
        "line": 9
       },
       "quote": "Talent Lead"
      }
     ],
