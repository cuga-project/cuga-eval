   "kind": "md",
   "title": "Prepaid Amortization Rules",
   "trust": "trusted",
   "effective_date": "2026-01-28",
   "authority_rank": 0,
   "sections": [
    {
     "id": "preamble",
     "title": "Preamble",
     "page": null,
     "parent": null,
     "statements": [
      {
       "id": "msg_amort_rules:preamble:1",
       "text": "Amortization rules:",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_amort_rules",
        "section": "preamble",
        "page": null,
        "line": 3
       },
       "quote": "Amortization rules:"
      },
      {
       "id": "msg_amort_rules:preamble:2",
       "text": "Monthly amount = Total Prepaid / Term in Months",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_amort_rules",
        "section": "preamble",
        "page": null,
        "line": 5,
        "step": 1
       },
       "quote": "Monthly amount = Total Prepaid / Term in Months"
      },
      {
       "id": "msg_amort_rules:preamble:3",
       "text": "Only amortize items where the current date falls within the coverage period",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_amort_rules",
        "section": "preamble",
        "page": null,
        "line": 6,
        "step": 2
       },
       "quote": "Only amortize items where the current date falls within the coverage period"
      },
      {
       "id": "msg_amort_rules:preamble:4",
       "text": "Items that haven't started yet (Start Date > current month): skip",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_amort_rules",
        "section": "preamble",
        "page": null,
        "line": 7,
        "step": 3
       },
       "quote": "Items that haven't started yet (Start Date > current month): skip"
      },
      {
       "id": "msg_amort_rules:preamble:5",
       "text": "Items fully amortized (Remaining = $0): skip",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_amort_rules",
        "section": "preamble",
        "page": null,
        "line": 8,
        "step": 4
       },
       "quote": "Items fully amortized (Remaining = $0): skip"
      },
      {
       "id": "msg_amort_rules:preamble:6",
       "text": "Round to nearest cent",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_amort_rules",
        "section": "preamble",
        "page": null,
        "line": 9,
        "step": 5
       },
       "quote": "Round to nearest cent"
      },
      {
       "id": "msg_amort_rules:preamble:7",
       "text": "Report: Debit Expense Account, Credit Prepaid Asset",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_amort_rules",
        "section": "preamble",
        "page": null,
        "line": 10,
        "step": 6
       },
       "quote": "Report: Debit Expense Account, Credit Prepaid Asset"
      },
      {
       "id": "msg_amort_rules:preamble:8",
       "text": "Controller",
