  {
   "id": "msg_vp_accel",
   "kind": "md",
   "title": "Insurance Amortization Acceleration",
   "trust": "trusted",
   "effective_date": "2026-01-30",
   "authority_rank": 1,
   "sections": [
    {
     "id": "preamble",
     "title": "Preamble",
     "page": null,
     "parent": null,
     "statements": [
      {
       "id": "msg_vp_accel:preamble:1",
       "text": "Team - per the policy review, the Annual Insurance prepaid should be amortized at double the monthly rate for February (2x the standard monthly amount).",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_vp_accel",
        "section": "preamble",
        "page": null,
        "line": 3
       },
       "quote": "Team - per the policy review, the Annual Insurance prepaid should be amortized at double the monthly rate for February (2x the standard monthly amount)."
      },
      {
       "id": "msg_vp_accel:preamble:2",
       "text": "We're accelerating recognition due to the mid-year policy change.",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_vp_accel",
        "section": "preamble",
        "page": null,
        "line": 3
       },
       "quote": "We're accelerating recognition due to the mid-year policy change."
      },
      {
       "id": "msg_vp_accel:preamble:3",
       "text": "This overrides the standard straight-line calculation for this item only.",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_vp_accel",
        "section": "preamble",
        "page": null,
        "line": 3
       },
       "quote": "This overrides the standard straight-line calculation for this item only."
      },
      {
       "id": "msg_vp_accel:preamble:4",
       "text": "All other items use standard amortization.",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_vp_accel",
        "section": "preamble",
        "page": null,
        "line": 3
       },
       "quote": "All other items use standard amortization."
      },
      {
       "id": "msg_vp_accel:preamble:5",
       "text": "VP Finance",
       "types": [],
       "modality": null,
       "source": {
        "document": "msg_vp_accel",
        "section": "preamble",
        "page": null,
