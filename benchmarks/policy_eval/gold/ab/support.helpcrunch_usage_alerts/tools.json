   "properties": {
    "to": {
     "description": "Recipient email address(es), comma-separated for multiple.",
     "title": "To",
     "type": "string"
    },
    "subject": {
     "description": "Email subject line.",
     "title": "Subject",
     "type": "string"
    },
    "body": {
     "description": "Email body content (plain text or HTML).",
     "title": "Body",
     "type": "string"
    },
    "cc": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "CC recipients, comma-separated.",
     "title": "Cc"
    },
    "bcc": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "BCC recipients, comma-separated.",
     "title": "Bcc"
    },
    "from_": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Sender email address (alias).",
     "title": "From"
    },
    "from_name": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Display name for sender.",
     "title": "From Name"
    },
    "reply_to": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Reply-to email address.",
     "title": "Reply To"
    },
    "body_type": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": "plain",
     "description": "Body format - \"plain\" or \"html\" (default: \"plain\").",
     "title": "Body Type"
    },
    "signature": {
