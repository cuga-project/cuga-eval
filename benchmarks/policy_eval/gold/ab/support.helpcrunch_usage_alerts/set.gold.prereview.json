      },
      {
       "id": "ws_alert_rules:preamble:4",
       "text": "Tag assignment | Each non-excluded customer | Tag as low-usage, normal-usage, or high-usage | Based on feature_use count vs thresholds",
       "types": [
        "allowed_values",
        "derived_value"
       ],
       "modality": "must",
