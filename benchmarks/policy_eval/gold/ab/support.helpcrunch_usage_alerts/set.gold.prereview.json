      },
      {
       "id": "ws_alert_rules:preamble:2",
       "text": "Trial detection | Customer has trial tag | Use trial thresholds from ws_thresholds | All others use standard thresholds",
       "types": [
        "lookup_matrix",
        "eligibility_filter"
       ],
       "modality": "must",
