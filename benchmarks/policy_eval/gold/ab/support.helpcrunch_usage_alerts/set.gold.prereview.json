      },
      {
       "id": "ws_alert_rules:preamble:3",
       "text": "Onboarding policy | See ws_onboarding_policy worksheet | Apply onboarding exclusion rules from separate sheet | Moved to dedicated worksheet for clarity",
       "types": [
        "eligibility_filter"
       ],
       "modality": "must",
