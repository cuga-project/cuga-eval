       "quote": "Tag assignment | Each non-excluded customer | Tag as low-usage, normal-usage, or high-usage | Based on feature_use count vs thresholds"
      },
      {
       "id": "ws_alert_rules:preamble:5",
       "text": "Low usage alert | Customer classified as low-usage | Send email + create Salesforce task | SF task subject must contain customer name",
       "types": [
        "notification_duty",
        "format"
       ],
       "modality": "must",
       "source": {
