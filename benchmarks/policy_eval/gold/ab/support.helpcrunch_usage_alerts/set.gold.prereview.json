  {
   "id": "ws_onboarding_policy",
   "kind": "md",
   "title": "Usage Thresholds: Onboarding Policy",
   "trust": "trusted",
   "effective_date": null,
   "authority_rank": 0,
   "sections": [
    {
     "id": "preamble",
     "title": "Preamble",
     "page": null,
     "parent": null,
     "statements": [
      {
       "id": "ws_onboarding_policy:preamble:1",
       "text": "Recently onboarded | Earliest event of ANY type within 7 days | Exclude entirely: no tag, no email, no SF task | Protects new customers from premature alerts",
       "types": [
        "eligibility_filter",
        "exception_override"
       ],
       "modality": "must_not",
       "source": {
        "document": "ws_onboarding_policy",
        "section": "preamble",
        "page": null,
        "line": 5,
        "table_header": [
         "Policy",
         "Condition",
         "Action",
         "Notes"
        ]
       },
       "quote": "Recently onboarded | Earliest event of ANY type within 7 days | Exclude entirely: no tag, no email, no SF task | Protects new customers from premature alerts"
      },
      {
       "id": "ws_onboarding_policy:preamble:2",
       "text": "Stale trial override | Customer tagged 'trial' but earliest event >90 days ago | Use standard thresholds instead of trial thresholds | Long-inactive trials should not get lenient trial thresholds",
       "types": [
        "exception_override",
        "threshold"
       ],
       "modality": "must",
       "source": {
        "document": "ws_onboarding_policy",
        "section": "preamble",
        "page": null,
        "line": 6,
        "table_header": [
         "Policy",
         "Condition",
         "Action",
         "Notes"
        ]
       },
       "quote": "Stale trial override | Customer tagged 'trial' but earliest event >90 days ago | Use standard thresholds instead of trial thresholds | Long-inactive trials should not get lenient trial thresholds"
      }
     ],
