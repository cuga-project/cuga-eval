     "title": "Cc"
    },
    "bcc": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "BCC recipients, comma-separated.",
     "title": "Bcc"
    },
    "from_": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Sender email address (alias).",
     "title": "From"
    },
    "from_name": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Display name for sender.",
     "title": "From Name"
    },
