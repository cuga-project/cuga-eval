# τ² (tau2-bench). What benchmarks/tau2/config/tau2.env sets where it differs from base.env. Benchmark mode: the task clock.
# The agent asks and confirms across the turns of a conversation, so it is not autonomous; tool execution stays in the
# process, because the tools reach τ² through an in-process bridge.
DYNACONF_ADVANCED_FEATURES__FORCE_AUTONOMOUS_MODE=false
DYNACONF_FEATURES__CHAT=false
DYNACONF_ADVANCED_FEATURES__LITE_MODE=true
DYNACONF_ADVANCED_FEATURES__E2B_SANDBOX=false
DYNACONF_ADVANCED_FEATURES__BENCHMARK=tau2
