# Agent: GLM 5.3 through CurveBender (IBM Cloud Gateway, an OpenAI-compatible endpoint), settings.openai.toml.
# Needs the CurveBender OPENAI_BASE_URL and key in cuga-eval/.env.
# Scores are not comparable with the LiteLLM route azure/FW-GLM-5.3-Flash: another provider, another serving stack.
AGENT_SETTING_CONFIG=settings.openai.toml
MODEL_NAME=glm-5-3
