# Agent: gpt-oss-120b through OpenRouter (an OpenAI-compatible endpoint), provider default reasoning (no reasoning_effort),
# max_tokens 16000 (settings.openai.gptoss-default.toml).
# Start the harness with --proxy https://openrouter.ai/api/v1 and OPENAI_API_KEY set to an OpenRouter key.
# Scores are not comparable with runs on the aws/ route: another provider, another serving stack.
AGENT_SETTING_CONFIG=settings.openai.gptoss-default.toml
MODEL_NAME=openai/gpt-oss-120b
