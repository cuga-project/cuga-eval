# HANDBOOK tasks need 45-200 tool calls; Gemini makes about one call per step, so the default 70 steps end every run early.
# Both arms of the Gemini runs use 400 steps (the HANDBOOK harness caps tool calls at 200). gpt-oss and DeepSeek runs used 70.
DYNACONF_ADVANCED_FEATURES__CUGA_LITE_MAX_STEPS=400
