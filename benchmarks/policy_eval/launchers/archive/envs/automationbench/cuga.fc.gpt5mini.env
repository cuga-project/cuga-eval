# Agent: Azure/gpt-5-mini-2025-08-07 - same settings as the gpt-oss-120b function-calling file except MODEL_NAME and AGENT_SETTING_CONFIG.
# CUGA settings for AutomationBench. Loaded by cuga with override=True (ENV_FILE).
# Secrets (OPENAI_API_KEY, OPENAI_BASE_URL) come from cuga-eval/.env via run_cuga.py.
AGENT_SETTING_CONFIG=settings.openai.toml
MODEL_NAME=Azure/gpt-5-mini-2025-08-07
CUGA_LLM_HTTP_TIMEOUT=120

# Benchmark mode: sandbox datetime is frozen to the task world's current_time.
DYNACONF_ADVANCED_FEATURES__BENCHMARK=automationbench
DYNACONF_ADVANCED_FEATURES__FORCE_AUTONOMOUS_MODE=true
DYNACONF_FEATURES__CUGA_MODE=accurate
DYNACONF_FEATURES__LOCAL_SANBDOX=true
DYNACONF_ADVANCED_FEATURES__REGISTRY=false
DYNACONF_ADVANCED_FEATURES__REFLECTION_ENABLED=true
DYNACONF_ADVANCED_FEATURES__PRE_EXECUTE_VERIFY_ENABLED=false
DYNACONF_ADVANCED_FEATURES__ENABLE_TODOS=false
DYNACONF_ADVANCED_FEATURES__CUGA_LITE_NL_AUTO_CONTINUE=true
DYNACONF_CONTEXT_SUMMARIZATION__ENABLED=true
DYNACONF_POLICY__ENABLED=false
DYNACONF_ADVANCED_FEATURES__TRACKER_ENABLED=true
DYNACONF_ADVANCED_FEATURES__RUN_RECEIPT=true
DYNACONF_ADVANCED_FEATURES__LANGFUSE_TRACING=false
DYNACONF_ADVANCED_FEATURES__SANDBOX_EXECUTION_TIMEOUT=120
CUGA_LOGGING_DIR=logging
LOGURU_LEVEL=INFO

# Keep the code sandbox checks on in benchmark mode (benchmark mode is only for the frozen task clock).
# Without this, agent code could read benchmark task files (seen 2026-11-01).
DYNACONF_ADVANCED_FEATURES__RELAXED_EXECUTION=false

# Same as cuga-eval benchmarks/appworld/config/appworld.env (2026-11-01, user request): no PRE_EXECUTE verify gate
# (set to false above), exact decomposition, high tool-call caps. AppWorld-only settings (registry, apps, ports,
# shortlisting thresholds) are not copied.
DYNACONF_ADVANCED_FEATURES__DECOMPOSITION_STRATEGY=exact
DYNACONF_ADVANCED_FEATURES__MAX_TOOL_CALLS_PER_BLOCK=1000
DYNACONF_ADVANCED_FEATURES__MAX_TOOL_CALLS_PER_RUN=3000
DYNACONF_ADVANCED_FEATURES__MAX_TOOL_CALLS_PER_THREAD=3000
# Retry once when the final answer reports actions as done but no code has executed (needs NL auto-continue on).
DYNACONF_ADVANCED_FEATURES__CUGA_LITE_UNEXECUTED_CLAIM_RETRY=true

# Function-calling mode (2026-11-02 overnight test): tools bound natively instead of CodeAct code blocks.
DYNACONF_ADVANCED_FEATURES__CUGA_LITE_EXECUTION_MODE=function_calling
DYNACONF_ADVANCED_FEATURES__CUGA_LITE_FC_PROMPT_FRAGMENTS=["evidence_first"]
